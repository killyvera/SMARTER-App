# Copiar a .env.local y completar valores.

DATABASE_URL=

# Supabase (dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública: publishable (sb_publishable_…) o anon (eyJ…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional si usás el nombre clásico en lugar de publishable:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (p. ej. subida de avatares a Storage). Nunca NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
