# Copiar a .env.local y completar valores.

DATABASE_URL=

# Supabase (dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública: publishable (sb_publishable_…) o anon (eyJ…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional si usás el nombre clásico en lugar de publishable:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Obligatorio para subir avatares a Storage (Dashboard → API → service role / secret).
# Nunca NEXT_PUBLIC_* ni código de cliente.
# SUPABASE_SERVICE_ROLE_KEY=
